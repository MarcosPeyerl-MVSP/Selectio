rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isEmpresa() {
      return signedIn()
        && exists(/databases/$(database)/documents/empresas/$(request.auth.uid));
    }

    function isIndicador() {
      return signedIn()
        && exists(/databases/$(database)/documents/indicadores/$(request.auth.uid));
    }

    function validUserTipo(tipo) {
      return tipo in ['empresa', 'indicador'];
    }

    function ownUserPayload(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && validUserTipo(request.resource.data.tipo);
    }

    function ownEmpresaPayload(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.firebaseUid == uid
        && request.resource.data.tipo == 'empresa';
    }

    function ownIndicadorPayload(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.firebaseUid == uid
        && request.resource.data.tipo == 'indicador';
    }

    function hasValidStatus(status) {
      return status in ['indicado', 'entrevista', 'contratado', 'cancelado', 'recusado'];
    }

    function statusUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'atualizadoEm'
      ]);
    }

    function sameCandidateOwnership() {
      return request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.vagaId == resource.data.vagaId;
    }

    function sameIndicacaoOwnership() {
      return request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.candidatoId == resource.data.candidatoId
        && request.resource.data.vagaId == resource.data.vagaId;
    }

    function isEmpresaOrIndicadorOwner(data) {
      return signedIn()
        && (
          data.empresaId == request.auth.uid
          || data.indicadorId == request.auth.uid
        );
    }

    function isEmpresaOwner(data) {
      return isEmpresa()
        && data.empresaId == request.auth.uid;
    }

    function sandboxPaymentCreate() {
      return isEmpresa()
        && request.resource.data.empresaId == request.auth.uid
        && request.resource.data.ambiente == 'sandbox'
        && request.resource.data.status == 'created'
        && request.resource.data.creditado == false
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.moeda == 'BRL'
        && request.resource.data.keys().hasOnly([
          'ambiente',
          'atualizadoEm',
          'candidatoId',
          'candidatoNome',
          'checkoutUrl',
          'criadoEm',
          'creditado',
          'descricao',
          'empresaId',
          'externalReference',
          'indicacaoId',
          'indicadorId',
          'indicadorNome',
          'mercadoPagoPaymentId',
          'mercadoPagoPreferenceId',
          'moeda',
          'sandboxCheckoutUrl',
          'status',
          'statusDetail',
          'transacaoId',
          'vagaId',
          'vagaTitulo',
          'valor'
        ]);
    }

    function sandboxPaymentUpdate() {
      return isEmpresaOwner(resource.data)
        && resource.data.ambiente == 'sandbox'
        && request.resource.data.ambiente == resource.data.ambiente
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.candidatoId == resource.data.candidatoId
        && request.resource.data.vagaId == resource.data.vagaId
        && request.resource.data.valor == resource.data.valor
        && request.resource.data.moeda == resource.data.moeda
        && request.resource.data.creditado == false
        && request.resource.data.status in [
          'created',
          'pending',
          'approved',
          'rejected',
          'cancelled',
          'refunded',
          'failed'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aprovadoEm',
          'atualizadoEm',
          'checkoutUrl',
          'encerradoEm',
          'erroCriacao',
          'mercadoPagoPaymentId',
          'mercadoPagoPreferenceId',
          'sandboxCheckoutUrl',
          'status',
          'statusDetail',
          'transacaoEm'
        ]);
    }

    function sandboxTransactionCreate() {
      return isEmpresa()
        && request.resource.data.empresaId == request.auth.uid
        && request.resource.data.ambiente == 'sandbox'
        && request.resource.data.status == 'created'
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.moeda == 'BRL'
        && request.resource.data.keys().hasOnly([
          'ambiente',
          'atualizadoEm',
          'criadoEm',
          'empresaId',
          'encerradoEm',
          'indicadorId',
          'mercadoPagoPaymentId',
          'mercadoPagoPreferenceId',
          'moeda',
          'pagamentoId',
          'status',
          'statusDetail',
          'transacaoEm',
          'valor'
        ]);
    }

    function sandboxTransactionUpdate() {
      return isEmpresaOwner(resource.data)
        && resource.data.ambiente == 'sandbox'
        && request.resource.data.ambiente == resource.data.ambiente
        && request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.pagamentoId == resource.data.pagamentoId
        && request.resource.data.valor == resource.data.valor
        && request.resource.data.moeda == resource.data.moeda
        && request.resource.data.status in [
          'created',
          'pending',
          'approved',
          'rejected',
          'cancelled',
          'refunded',
          'failed'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'atualizadoEm',
          'encerradoEm',
          'mercadoPagoPaymentId',
          'mercadoPagoPreferenceId',
          'status',
          'statusDetail',
          'transacaoEm'
        ]);
    }

    function vagaEmpresaMatches(data) {
      return data.vagaId is string
        && data.empresaId is string
        && exists(/databases/$(database)/documents/vagas/$(data.vagaId))
        && get(/databases/$(database)/documents/vagas/$(data.vagaId)).data.empresaId == data.empresaId;
    }

    function isNotificationOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function notificationReadUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lida',
        'lidaEm'
      ])
        && request.resource.data.lida == true;
    }

    function hasValidInterviewStatus(status) {
      return status in ['agendada', 'realizada', 'cancelada', 'pendente'];
    }

    function sameInterviewOwnership() {
      return request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.candidatoId == resource.data.candidatoId
        && request.resource.data.vagaId == resource.data.vagaId;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if ownUserPayload(uid);
      allow delete: if false;
    }

    match /empresas/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if ownEmpresaPayload(uid);
      allow delete: if false;
    }

    match /indicadores/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if ownIndicadorPayload(uid);
      allow delete: if false;
    }

    match /vagas/{vagaId} {
      allow read: if true;

      allow create: if isEmpresa()
        && request.resource.data.empresaId == request.auth.uid
        && (!('empresaUid' in request.resource.data) || request.resource.data.empresaUid == request.auth.uid);

      allow update: if isEmpresa()
        && resource.data.empresaId == request.auth.uid
        && request.resource.data.empresaId == resource.data.empresaId
        && (!('empresaUid' in resource.data) || request.resource.data.empresaUid == resource.data.empresaUid);

      allow delete: if isEmpresa()
        && resource.data.empresaId == request.auth.uid;
    }

    match /candidatos/{candidatoId} {
      allow create: if isIndicador()
        && request.resource.data.indicadorId == request.auth.uid
        && request.resource.data.status == 'indicado'
        && vagaEmpresaMatches(request.resource.data);

      allow read: if isEmpresaOrIndicadorOwner(resource.data);

      allow update: if isEmpresaOwner(resource.data)
        && sameCandidateOwnership()
        && statusUpdateOnly()
        && hasValidStatus(request.resource.data.status);

      allow delete: if false;
    }

    match /indicacoes/{indicacaoId} {
      allow create: if isIndicador()
        && request.resource.data.indicadorId == request.auth.uid
        && request.resource.data.status == 'indicado'
        && vagaEmpresaMatches(request.resource.data);

      allow read: if isEmpresaOrIndicadorOwner(resource.data);

      allow update: if isEmpresaOwner(resource.data)
        && sameIndicacaoOwnership()
        && statusUpdateOnly()
        && hasValidStatus(request.resource.data.status);

      allow delete: if false;
    }

    match /entrevistas/{entrevistaId} {
      allow create: if isEmpresa()
        && request.resource.data.empresaId == request.auth.uid
        && hasValidInterviewStatus(request.resource.data.status);

      allow read: if isEmpresaOrIndicadorOwner(resource.data);

      allow update: if isEmpresaOwner(resource.data)
        && sameInterviewOwnership()
        && hasValidInterviewStatus(request.resource.data.status);

      allow delete: if isEmpresaOwner(resource.data);
    }

    match /pagamentos/{pagamentoId} {
      allow read: if isEmpresaOrIndicadorOwner(resource.data);
      allow create: if sandboxPaymentCreate();
      allow update: if sandboxPaymentUpdate();
      allow delete: if false;
    }

    match /transacoesPagamento/{transacaoId} {
      allow read: if isEmpresaOrIndicadorOwner(resource.data);
      allow create: if sandboxTransactionCreate();
      allow update: if sandboxTransactionUpdate();
      allow delete: if false;
    }

    match /indicadorSaldos/{indicadorId} {
      allow read: if isOwner(indicadorId);
      allow create, update, delete: if false;
    }

    match /movimentacoesFinanceiras/{movimentacaoId} {
      allow read: if isEmpresaOrIndicadorOwner(resource.data);
      allow create, update, delete: if false;
    }

    match /notificacoes/{notificacaoId} {
      allow read: if isNotificationOwner();
      allow update: if isNotificationOwner()
        && request.resource.data.userId == resource.data.userId
        && notificationReadUpdateOnly();
      allow create, delete: if false;
    }

    match /saques/{saqueId} {
      allow read: if signedIn() && resource.data.indicadorId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
