rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isEmpresa() {
      return signedIn()
        && exists(/databases/$(database)/documents/empresas/$(request.auth.uid));
    }

    function isIndicador() {
      return signedIn()
        && exists(/databases/$(database)/documents/indicadores/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.papel == 'admin'
        );
    }

    function validUserTipo(tipo) {
      return tipo in ['empresa', 'indicador'];
    }

    function validVagaStatus(status) {
      return status in ['aberta', 'pausada', 'encerrada'];
    }

    function ownUserPayload(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && validUserTipo(request.resource.data.tipo)
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin')
        && (!('papel' in request.resource.data) || request.resource.data.papel != 'admin');
    }

    function validOnboardingTourPayload() {
      return !('onboardingTour' in request.resource.data)
        || (
          request.resource.data.onboardingTour is map
          &&
          request.resource.data.onboardingTour.keys().hasOnly([
            'empresaConcluido',
            'indicadorConcluido'
          ])
          && (!('empresaConcluido' in request.resource.data.onboardingTour)
            || request.resource.data.onboardingTour.empresaConcluido is bool)
          && (!('indicadorConcluido' in request.resource.data.onboardingTour)
            || request.resource.data.onboardingTour.indicadorConcluido is bool)
        );
    }

    function ownUserUpdatePayload(uid) {
      return ownUserPayload(uid)
        && validOnboardingTourPayload()
        && (!('tourEmpresaConcluido' in request.resource.data)
          || request.resource.data.tourEmpresaConcluido is bool)
        && (!('tourIndicadorConcluido' in request.resource.data)
          || request.resource.data.tourIndicadorConcluido is bool)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'atualizadoEm',
          'email',
          'nome',
          'onboardingTour',
          'tourEmpresaConcluido',
          'tourIndicadorConcluido'
        ]);
    }

    function ownEmpresaPayload(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.firebaseUid == uid
        && request.resource.data.tipo == 'empresa';
    }

    function ownIndicadorPayload(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.firebaseUid == uid
        && request.resource.data.tipo == 'indicador';
    }

    function hasValidStatus(status) {
      return status in ['indicado', 'entrevista', 'contratado', 'cancelado', 'recusado'];
    }

    function statusUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'atualizadoEm'
      ]);
    }

    function sameCandidateOwnership() {
      return request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.vagaId == resource.data.vagaId;
    }

    function sameIndicacaoOwnership() {
      return request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.candidatoId == resource.data.candidatoId
        && request.resource.data.vagaId == resource.data.vagaId;
    }

    function isEmpresaOrIndicadorOwner(data) {
      return signedIn()
        && (
          isAdmin()
          ||
          data.empresaId == request.auth.uid
          || data.indicadorId == request.auth.uid
        );
    }

    function isEmpresaOwner(data) {
      return isEmpresa()
        && data.empresaId == request.auth.uid;
    }

    function vagaEmpresaMatches(data) {
      return data.vagaId is string
        && data.empresaId is string
        && exists(/databases/$(database)/documents/vagas/$(data.vagaId))
        && get(/databases/$(database)/documents/vagas/$(data.vagaId)).data.empresaId == data.empresaId;
    }

    function vagaAceitaIndicacoes(data) {
      return vagaEmpresaMatches(data)
        && (
          !('status' in get(/databases/$(database)/documents/vagas/$(data.vagaId)).data)
          || get(/databases/$(database)/documents/vagas/$(data.vagaId)).data.status == 'aberta'
        )
        && (
          !('expiraEm' in get(/databases/$(database)/documents/vagas/$(data.vagaId)).data)
          || get(/databases/$(database)/documents/vagas/$(data.vagaId)).data.expiraEm == null
          || get(/databases/$(database)/documents/vagas/$(data.vagaId)).data.expiraEm > request.time
        );
    }

    function validPreSavedCandidatePayload(candidatoId) {
      return request.resource.data.keys().hasOnly([
          'anosExperiencia',
          'avisoPrevio',
          'cargoAtual',
          'createdAt',
          'curriculo',
          'curriculoNome',
          'dataNascimento',
          'destaquesProjetos',
          'email',
          'emailNormalizado',
          'escolaridade',
          'expectativaSalarial',
          'fitCultural',
          'genero',
          'github',
          'hardSkills',
          'id',
          'indicadorId',
          'indicadorUid',
          'linkedin',
          'modeloTrabalho',
          'narrativa',
          'nome',
          'observacoesProfissionais',
          'origem',
          'pontosFortes',
          'portfolio',
          'proficienciaIdiomas',
          'softSkills',
          'status',
          'telefone',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'createdAt',
          'email',
          'emailNormalizado',
          'hardSkills',
          'id',
          'indicadorId',
          'indicadorUid',
          'nome',
          'origem',
          'softSkills',
          'status',
          'updatedAt'
        ])
        && request.resource.data.id == candidatoId
        && request.resource.data.indicadorId == request.auth.uid
        && request.resource.data.indicadorUid == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.indicadorId is string
        && request.resource.data.indicadorUid is string
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 320
        && request.resource.data.emailNormalizado is string
        && request.resource.data.email == request.resource.data.emailNormalizado
        && request.resource.data.email.matches('^[^@/]+@[^@/]+[.][^@/]+$')
        && (!('anosExperiencia' in request.resource.data)
          || request.resource.data.anosExperiencia is string)
        && (!('avisoPrevio' in request.resource.data)
          || request.resource.data.avisoPrevio is string)
        && (!('cargoAtual' in request.resource.data)
          || request.resource.data.cargoAtual is string)
        && (!('curriculoNome' in request.resource.data)
          || request.resource.data.curriculoNome is string)
        && (!('dataNascimento' in request.resource.data)
          || request.resource.data.dataNascimento is string)
        && (!('destaquesProjetos' in request.resource.data)
          || request.resource.data.destaquesProjetos is string)
        && (!('escolaridade' in request.resource.data)
          || request.resource.data.escolaridade is string)
        && (!('expectativaSalarial' in request.resource.data)
          || request.resource.data.expectativaSalarial is string)
        && (!('fitCultural' in request.resource.data)
          || request.resource.data.fitCultural is string)
        && (!('genero' in request.resource.data)
          || request.resource.data.genero is string)
        && (!('github' in request.resource.data)
          || request.resource.data.github is string)
        && request.resource.data.hardSkills is list
        && request.resource.data.hardSkills.size() <= 100
        && (!('linkedin' in request.resource.data)
          || request.resource.data.linkedin is string)
        && (!('modeloTrabalho' in request.resource.data)
          || request.resource.data.modeloTrabalho is string)
        && (!('narrativa' in request.resource.data)
          || request.resource.data.narrativa is string)
        && (!('observacoesProfissionais' in request.resource.data)
          || request.resource.data.observacoesProfissionais is string)
        && (!('pontosFortes' in request.resource.data)
          || request.resource.data.pontosFortes is string)
        && (!('portfolio' in request.resource.data)
          || request.resource.data.portfolio is string)
        && (!('proficienciaIdiomas' in request.resource.data)
          || request.resource.data.proficienciaIdiomas is string)
        && request.resource.data.softSkills is list
        && request.resource.data.softSkills.size() <= 100
        && (!('telefone' in request.resource.data)
          || request.resource.data.telefone is string)
        && request.resource.data.curriculo is map
        && request.resource.data.curriculo.keys().hasOnly([
          'caminho',
          'nome',
          'tamanho',
          'tipo',
          'url'
        ])
        && (!('caminho' in request.resource.data.curriculo)
          || request.resource.data.curriculo.caminho is string)
        && (!('nome' in request.resource.data.curriculo)
          || request.resource.data.curriculo.nome is string)
        && (!('tamanho' in request.resource.data.curriculo)
          || request.resource.data.curriculo.tamanho is number)
        && (!('tipo' in request.resource.data.curriculo)
          || request.resource.data.curriculo.tipo is string)
        && (!('url' in request.resource.data.curriculo)
          || request.resource.data.curriculo.url is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.origem in ['manual', 'csv']
        && request.resource.data.status == 'pre_salvo';
    }

    function validPreSavedCandidateCreate(candidatoId) {
      return validPreSavedCandidatePayload(candidatoId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validPreSavedCandidateUpdate(candidatoId) {
      return validPreSavedCandidatePayload(candidatoId)
        && resource.data.indicadorId == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.origem == resource.data.origem
        && request.resource.data.status == resource.data.status
        && request.resource.data.updatedAt == request.time;
    }

    function hasPreSavedCandidateReference(data) {
      return 'candidatoPreSalvoId' in data;
    }

    function preSavedCandidateReferenceMatchesOwner(data) {
      return !hasPreSavedCandidateReference(data)
        || (
          data.candidatoPreSalvoId is string
          && data.candidatoPreSalvoId.size() > 0
          && existsAfter(/databases/$(database)/documents/candidatosPreSalvos/$(data.candidatoPreSalvoId))
          && getAfter(/databases/$(database)/documents/candidatosPreSalvos/$(data.candidatoPreSalvoId)).data.indicadorId
            == data.indicadorId
        );
    }

    function indicationPreSavedReferenceMatchesCandidate(data) {
      let candidate = getAfter(/databases/$(database)/documents/candidatos/$(data.candidatoId)).data;
      return (
          !hasPreSavedCandidateReference(data)
          && !hasPreSavedCandidateReference(candidate)
        )
        || (
          hasPreSavedCandidateReference(data)
          && hasPreSavedCandidateReference(candidate)
          && data.candidatoPreSalvoId == candidate.candidatoPreSalvoId
          && preSavedCandidateReferenceMatchesOwner(data)
        );
    }

    function canonicalPreSavedIndicationId(indicacaoId, data) {
      return !hasPreSavedCandidateReference(data)
        || indicacaoId == data.indicadorId
          + '__'
          + data.vagaId
          + '__'
          + data.candidatoPreSalvoId;
    }

    function candidateCanonicalPreSavedIndicationMatches(candidatoId, data) {
      let indicacaoId = data.indicadorId
        + '__'
        + data.vagaId
        + '__'
        + data.candidatoPreSalvoId;
      let indicacao = getAfter(/databases/$(database)/documents/indicacoes/$(indicacaoId)).data;
      return existsAfter(/databases/$(database)/documents/indicacoes/$(indicacaoId))
        && indicacao.candidatoId == candidatoId
        && indicacao.candidatoPreSalvoId == data.candidatoPreSalvoId
        && indicacao.indicadorId == data.indicadorId
        && indicacao.empresaId == data.empresaId
        && indicacao.vagaId == data.vagaId;
    }

    function candidateHasCanonicalPreSavedIndication(candidatoId, data) {
      return !hasPreSavedCandidateReference(data)
        || candidateCanonicalPreSavedIndicationMatches(candidatoId, data);
    }

    function referencedCandidateMatches(data) {
      return data.candidatoId is string
        && data.empresaId is string
        && data.indicadorId is string
        && data.vagaId is string
        && existsAfter(/databases/$(database)/documents/candidatos/$(data.candidatoId))
        && getAfter(/databases/$(database)/documents/candidatos/$(data.candidatoId)).data.empresaId == data.empresaId
        && getAfter(/databases/$(database)/documents/candidatos/$(data.candidatoId)).data.indicadorId == data.indicadorId
        && getAfter(/databases/$(database)/documents/candidatos/$(data.candidatoId)).data.vagaId == data.vagaId;
    }

    function isNotificationOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function notificationCreatePayload() {
      return signedIn()
        && request.resource.data.keys().hasOnly([
          'criadoEm',
          'criadoPor',
          'link',
          'lida',
          'mensagem',
          'metadata',
          'origem',
          'tipo',
          'titulo',
          'userId'
        ])
        && request.resource.data.userId is string
        && request.resource.data.tipo is string
        && request.resource.data.titulo is string
        && request.resource.data.mensagem is string
        && request.resource.data.link is string
        && request.resource.data.metadata is map
        && request.resource.data.lida == false
        && request.resource.data.origem == 'app'
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time;
    }

    function notificationHasCandidate() {
      return request.resource.data.metadata.candidatoId is string
        && exists(/databases/$(database)/documents/candidatos/$(request.resource.data.metadata.candidatoId));
    }

    function notificationCandidate() {
      return get(/databases/$(database)/documents/candidatos/$(request.resource.data.metadata.candidatoId)).data;
    }

    function notificationCandidatePayload() {
      return notificationCreatePayload()
        && notificationHasCandidate()
        && request.resource.data.metadata.empresaId == notificationCandidate().empresaId
        && request.resource.data.metadata.indicadorId == notificationCandidate().indicadorId
        && request.resource.data.metadata.vagaId == notificationCandidate().vagaId;
    }

    function notificationStatusTypeMatches(status, tipo) {
      return (status == 'entrevista' && tipo == 'candidato_entrevista')
        || (status == 'contratado' && tipo == 'candidato_contratado')
        || (status == 'cancelado' && tipo == 'candidato_cancelado')
        || (status == 'recusado' && tipo == 'candidato_recusado');
    }

    function notificationHasInterview() {
      return request.resource.data.metadata.entrevistaId is string
        && exists(/databases/$(database)/documents/entrevistas/$(request.resource.data.metadata.entrevistaId));
    }

    function notificationInterview() {
      return get(/databases/$(database)/documents/entrevistas/$(request.resource.data.metadata.entrevistaId)).data;
    }

    function notificationInterviewStatusTypeMatches(status, tipo) {
      return (status == 'agendada' && tipo == 'entrevista_agendada')
        || (status == 'pendente' && tipo == 'entrevista_pendente')
        || (status == 'realizada' && tipo == 'entrevista_realizada')
        || (status == 'cancelada' && tipo == 'entrevista_cancelada');
    }

    function notificationHasPayment() {
      return request.resource.data.metadata.pagamentoId is string
        && exists(/databases/$(database)/documents/pagamentos/$(request.resource.data.metadata.pagamentoId));
    }

    function notificationPayment() {
      return get(/databases/$(database)/documents/pagamentos/$(request.resource.data.metadata.pagamentoId)).data;
    }

    function notificationPaymentStatusTypeMatches(status, tipo) {
      return (status == 'created' && tipo == 'pagamento_criado')
        || (status == 'pending' && tipo == 'pagamento_pendente')
        || (status == 'approved' && tipo == 'pagamento_aprovado')
        || (status == 'rejected' && tipo == 'pagamento_recusado')
        || (status == 'cancelled' && tipo == 'pagamento_cancelado')
        || (status == 'refunded' && tipo == 'pagamento_estornado')
        || (status == 'failed' && tipo == 'pagamento_falhou');
    }

    function notificationNewCandidateCreate() {
      return notificationCandidatePayload()
        && request.resource.data.tipo == 'novo_candidato'
        && request.resource.data.userId == notificationCandidate().empresaId
        && notificationCandidate().indicadorId == request.auth.uid;
    }

    function notificationReferralSentCreate() {
      return notificationCandidatePayload()
        && request.resource.data.tipo == 'indicacao_enviada'
        && request.resource.data.userId == request.auth.uid
        && notificationCandidate().indicadorId == request.auth.uid;
    }

    function notificationCandidateStatusCreate() {
      return notificationCandidatePayload()
        && notificationCandidate().empresaId == request.auth.uid
        && request.resource.data.userId == notificationCandidate().indicadorId
        && request.resource.data.metadata.statusAtual == notificationCandidate().status
        && notificationStatusTypeMatches(
          request.resource.data.metadata.statusAtual,
          request.resource.data.tipo
        );
    }

    function notificationRewardPendingCreate() {
      return notificationCandidatePayload()
        && request.resource.data.tipo == 'recompensa_pendente'
        && request.resource.data.userId == request.auth.uid
        && notificationCandidate().empresaId == request.auth.uid
        && request.resource.data.metadata.statusAtual == 'contratado'
        && notificationCandidate().status == 'contratado';
    }

    function notificationInterviewPayload() {
      return notificationCreatePayload()
        && notificationHasInterview()
        && request.resource.data.metadata.empresaId == notificationInterview().empresaId
        && request.resource.data.metadata.indicadorId == notificationInterview().indicadorId
        && request.resource.data.metadata.candidatoId == notificationInterview().candidatoId
        && request.resource.data.metadata.vagaId == notificationInterview().vagaId;
    }

    function notificationInterviewCreate() {
      return notificationInterviewPayload()
        && notificationInterview().empresaId == request.auth.uid
        && (
          request.resource.data.userId == notificationInterview().empresaId
          || request.resource.data.userId == notificationInterview().indicadorId
        )
        && request.resource.data.metadata.statusAtual == notificationInterview().status
        && notificationInterviewStatusTypeMatches(
          request.resource.data.metadata.statusAtual,
          request.resource.data.tipo
        );
    }

    function notificationPaymentPayload() {
      return notificationCreatePayload()
        && notificationHasPayment()
        && request.resource.data.metadata.empresaId == notificationPayment().empresaId
        && request.resource.data.metadata.indicadorId == notificationPayment().indicadorId
        && request.resource.data.metadata.candidatoId == notificationPayment().candidatoId
        && request.resource.data.metadata.vagaId == notificationPayment().vagaId;
    }

    function notificationPaymentCreate() {
      return notificationPaymentPayload()
        && notificationPayment().empresaId == request.auth.uid
        && (
          request.resource.data.userId == notificationPayment().empresaId
          || request.resource.data.userId == notificationPayment().indicadorId
        )
        && request.resource.data.metadata.statusAtual == notificationPayment().status
        && notificationPaymentStatusTypeMatches(
          request.resource.data.metadata.statusAtual,
          request.resource.data.tipo
        );
    }

    function notificationCreateAllowed() {
      return notificationNewCandidateCreate()
        || notificationReferralSentCreate()
        || notificationCandidateStatusCreate()
        || notificationRewardPendingCreate()
        || notificationInterviewCreate()
        || notificationPaymentCreate();
    }

    function notificationReadUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'lida',
        'lidaEm'
      ])
        && request.resource.data.lida == true;
    }

    function hasValidInterviewStatus(status) {
      return status in ['agendada', 'realizada', 'cancelada', 'pendente'];
    }

    function sameInterviewOwnership() {
      return request.resource.data.empresaId == resource.data.empresaId
        && request.resource.data.indicadorId == resource.data.indicadorId
        && request.resource.data.candidatoId == resource.data.candidatoId
        && request.resource.data.vagaId == resource.data.vagaId;
    }

    function historyCandidate(data) {
      return getAfter(/databases/$(database)/documents/candidatos/$(data.candidatoId)).data;
    }

    function historyCandidateMatches(data) {
      return data.candidatoId is string
        && data.empresaId is string
        && data.indicadorId is string
        && data.vagaId is string
        && existsAfter(/databases/$(database)/documents/candidatos/$(data.candidatoId))
        && historyCandidate(data).empresaId == data.empresaId
        && historyCandidate(data).indicadorId == data.indicadorId
        && historyCandidate(data).vagaId == data.vagaId;
    }

    function historyInterviewMatches(data) {
      return data.entrevistaId is string
        && existsAfter(/databases/$(database)/documents/entrevistas/$(data.entrevistaId))
        && getAfter(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.candidatoId == data.candidatoId
        && getAfter(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.empresaId == data.empresaId
        && getAfter(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.indicadorId == data.indicadorId
        && getAfter(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.vagaId == data.vagaId;
    }

    function historyPayloadIsValid() {
      return request.resource.data.keys().hasOnly([
          'candidatoId',
          'candidatoNome',
          'criadoEm',
          'criadoPor',
          'descricao',
          'empresaId',
          'entrevistaId',
          'indicadorId',
          'statusAnterior',
          'statusAtual',
          'tipo',
          'titulo',
          'vagaId',
          'vagaTitulo'
        ])
        && request.resource.data.candidatoNome is string
        && request.resource.data.vagaTitulo is string
        && request.resource.data.entrevistaId is string
        && request.resource.data.statusAnterior is string
        && request.resource.data.statusAtual is string
        && request.resource.data.tipo is string
        && request.resource.data.titulo is string
        && request.resource.data.descricao is string;
    }

    function historyCandidateWasCreated(data) {
      return !exists(/databases/$(database)/documents/candidatos/$(data.candidatoId))
        && historyCandidate(data).status == 'indicado';
    }

    function historyCandidateStatusChanged(data) {
      return exists(/databases/$(database)/documents/candidatos/$(data.candidatoId))
        && get(/databases/$(database)/documents/candidatos/$(data.candidatoId)).data.status != historyCandidate(data).status
        && data.statusAnterior == get(/databases/$(database)/documents/candidatos/$(data.candidatoId)).data.status
        && data.statusAtual == historyCandidate(data).status;
    }

    function historyInterviewTypeMatches(data) {
      let status = getAfter(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.status;
      return (status == 'agendada' && data.tipo == 'entrevista_agendada')
        || (status == 'pendente' && data.tipo == 'entrevista_pendente')
        || (status == 'realizada' && data.tipo == 'entrevista_realizada')
        || (status == 'cancelada' && data.tipo == 'entrevista_cancelada');
    }

    function historyInterviewWasCreatedOrChanged(data) {
      return historyInterviewTypeMatches(data)
        && (
          (
            !exists(/databases/$(database)/documents/entrevistas/$(data.entrevistaId))
            && data.tipo == 'entrevista_agendada'
            && data.statusAnterior == ''
          )
          || (
            exists(/databases/$(database)/documents/entrevistas/$(data.entrevistaId))
            && get(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.status
              != getAfter(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.status
            && data.statusAnterior
              == get(/databases/$(database)/documents/entrevistas/$(data.entrevistaId)).data.status
          )
        );
    }

    function historyCreateAllowed() {
      return signedIn()
        && request.resource.data.criadoPor == request.auth.uid
        && request.resource.data.criadoEm == request.time
        && historyPayloadIsValid()
        && historyCandidateMatches(request.resource.data)
        && (
          (
            request.resource.data.tipo == 'indicacao_criada'
            && request.resource.data.indicadorId == request.auth.uid
            && historyCandidateWasCreated(request.resource.data)
          )
          || (
            request.resource.data.tipo == 'status_alterado'
            && request.resource.data.empresaId == request.auth.uid
            && historyCandidateStatusChanged(request.resource.data)
          )
          || (
            request.resource.data.tipo in [
              'entrevista_agendada',
              'entrevista_pendente',
              'entrevista_realizada',
              'entrevista_cancelada'
            ]
            && request.resource.data.empresaId == request.auth.uid
            && historyInterviewMatches(request.resource.data)
            && historyInterviewWasCreatedOrChanged(request.resource.data)
          )
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if ownUserPayload(uid);
      allow update: if ownUserUpdatePayload(uid);
      allow delete: if false;
    }

    match /empresas/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if ownEmpresaPayload(uid);
      allow delete: if false;
    }

    match /indicadores/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if ownIndicadorPayload(uid);
      allow delete: if false;
    }

    match /vagas/{vagaId} {
      allow read: if true;

      allow create: if isEmpresa()
        && request.resource.data.empresaId == request.auth.uid
        && validVagaStatus(request.resource.data.status)
        && (!('empresaUid' in request.resource.data) || request.resource.data.empresaUid == request.auth.uid);

      allow update: if isEmpresa()
        && resource.data.empresaId == request.auth.uid
        && request.resource.data.empresaId == resource.data.empresaId
        && validVagaStatus(request.resource.data.status)
        && (!('empresaUid' in request.resource.data)
          || request.resource.data.empresaUid == request.auth.uid);

      allow delete: if isEmpresa()
        && resource.data.empresaId == request.auth.uid;
    }

    match /candidatos/{candidatoId} {
      allow create: if isIndicador()
        && request.resource.data.indicadorId == request.auth.uid
        && (!('indicadorUid' in request.resource.data)
          || request.resource.data.indicadorUid == request.auth.uid)
        && (!('empresaUid' in request.resource.data)
          || request.resource.data.empresaUid == request.resource.data.empresaId)
        && request.resource.data.status == 'indicado'
        && preSavedCandidateReferenceMatchesOwner(request.resource.data)
        && candidateHasCanonicalPreSavedIndication(candidatoId, request.resource.data)
        && vagaAceitaIndicacoes(request.resource.data);

      allow read: if isEmpresaOrIndicadorOwner(resource.data);

      allow update: if isEmpresaOwner(resource.data)
        && sameCandidateOwnership()
        && statusUpdateOnly()
        && hasValidStatus(request.resource.data.status);

      allow delete: if false;
    }

    match /candidatosPreSalvos/{candidatoId} {
      allow create: if isIndicador()
        && validPreSavedCandidateCreate(candidatoId);

      allow read: if isIndicador()
        && resource.data.indicadorId == request.auth.uid;

      allow update: if isIndicador()
        && validPreSavedCandidateUpdate(candidatoId);

      allow delete: if isIndicador()
        && resource.data.indicadorId == request.auth.uid;
    }

    match /indicacoes/{indicacaoId} {
      allow create: if isIndicador()
        && request.resource.data.indicadorId == request.auth.uid
        && (!('indicadorUid' in request.resource.data)
          || request.resource.data.indicadorUid == request.auth.uid)
        && (!('empresaUid' in request.resource.data)
          || request.resource.data.empresaUid == request.resource.data.empresaId)
        && request.resource.data.status == 'indicado'
        && vagaAceitaIndicacoes(request.resource.data)
        && referencedCandidateMatches(request.resource.data)
        && indicationPreSavedReferenceMatchesCandidate(request.resource.data)
        && canonicalPreSavedIndicationId(indicacaoId, request.resource.data);

      allow read: if isEmpresaOrIndicadorOwner(resource.data);

      allow update: if isEmpresaOwner(resource.data)
        && sameIndicacaoOwnership()
        && statusUpdateOnly()
        && hasValidStatus(request.resource.data.status);

      allow delete: if false;
    }

    match /entrevistas/{entrevistaId} {
      allow create: if isEmpresa()
        && request.resource.data.empresaId == request.auth.uid
        && hasValidInterviewStatus(request.resource.data.status)
        && referencedCandidateMatches(request.resource.data);

      allow read: if isEmpresaOrIndicadorOwner(resource.data);

      allow update: if isEmpresaOwner(resource.data)
        && sameInterviewOwnership()
        && hasValidInterviewStatus(request.resource.data.status)
        && referencedCandidateMatches(request.resource.data);

      allow delete: if isEmpresaOwner(resource.data);
    }

    match /historicoProcesso/{eventoId} {
      allow read: if isEmpresaOrIndicadorOwner(resource.data);
      allow create: if historyCreateAllowed();
      allow update, delete: if false;
    }

    match /pagamentos/{pagamentoId} {
      allow read: if isEmpresaOrIndicadorOwner(resource.data);
      allow create, update: if false;
      allow delete: if false;
    }

    match /transacoesPagamento/{transacaoId} {
      allow read: if isEmpresaOrIndicadorOwner(resource.data);
      allow create, update: if false;
      allow delete: if false;
    }

    match /indicadorSaldos/{indicadorId} {
      allow read: if isOwner(indicadorId) || isAdmin();
      allow create, update, delete: if false;
    }

    match /movimentacoesFinanceiras/{movimentacaoId} {
      allow read: if isEmpresaOrIndicadorOwner(resource.data);
      allow create, update, delete: if false;
    }

    match /notificacoes/{notificacaoId} {
      allow read: if isNotificationOwner();
      allow update: if isNotificationOwner()
        && request.resource.data.userId == resource.data.userId
        && notificationReadUpdateOnly();
      allow create: if notificationCreateAllowed();
      allow delete: if false;
    }

    match /saques/{saqueId} {
      allow read: if signedIn()
        && (resource.data.indicadorId == request.auth.uid || isAdmin());
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
