#!/bin/sh

zero=0000000000000000000000000000000000000000
remote_name="$1"

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    remote_branch=${remote_ref#refs/heads/}
    tracking_ref="refs/remotes/$remote_name/$remote_branch"

    if [ -n "$remote_name" ] && git show-ref --verify --quiet "$tracking_ref"; then
      echo "Aviso: commit remoto indisponivel localmente; verificando a partir de $tracking_ref." >&2
      range="$tracking_ref..$local_sha"
    else
      echo "Aviso: referencia remota indisponivel localmente; verificando todo o historico enviado." >&2
      range="$local_sha"
    fi
  fi

  node scripts/check-secrets.cjs --range "$range" || exit 1
done
